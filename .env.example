# ==============================================================================
# VENDOSMITH ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local (development) or configure in hosting provider (staging/prod)
# NEVER commit real API keys, secrets, or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE & AUTHENTICATION
# ------------------------------------------------------------------------------
# Public Supabase API Gateway URL
# Format: https://<project-ref>.supabase.co or http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Public Anonymous Client Key (used by browser client for auth & public reads)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Administrative Service Role Key (STRICTLY SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Required for server-side order transactions, atomic RPCs, and Cashfree webhook handlers
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ------------------------------------------------------------------------------
# 2. STAGING EDGE GUARD & SAFETY ALLOWLISTS
# ------------------------------------------------------------------------------
# In TEST / Staging mode, lib/supabase-edge-guard.ts enforces that hosted Supabase URLs
# must match an explicit allowlist. Any connection to production (ddrwsbfrhuzunvgcezaw)
# or an unapproved hosted project ref fails closed immediately.
#
# Comma-separated list of approved staging project references:
APPROVED_STAGING_SUPABASE_REFS="your-staging-project-ref"

# Alternative single-reference variable:
STAGING_SUPABASE_PROJECT_REF="your-staging-project-ref"

# Public reference variable (optional client-side edge guard):
NEXT_PUBLIC_STAGING_SUPABASE_REF="your-staging-project-ref"

# ------------------------------------------------------------------------------
# 3. CASHFREE PAYMENT GATEWAY (SANDBOX / PRODUCTION)
# ------------------------------------------------------------------------------
# Environment Mode: Strictly "TEST" for Staging/Development; "PRODUCTION" for Live
CASHFREE_ENVIRONMENT="TEST"
NEXT_PUBLIC_CASHFREE_ENVIRONMENT="TEST"

# Cashfree API Credentials (obtain from Cashfree Merchant Dashboard)
CASHFREE_APP_ID="your-cashfree-app-id"
CASHFREE_SECRET_KEY="your-cashfree-secret-key"

# Public App ID for Cashfree JS Checkout SDK
NEXT_PUBLIC_CASHFREE_APP_ID="your-cashfree-app-id"

# ------------------------------------------------------------------------------
# 4. DATA SECURITY & ENCRYPTION
# ------------------------------------------------------------------------------
# AES-256-GCM encryption key for seller bank details in seller_bank_accounts
# Must be a cryptographically secure random string of at least 32 characters
BANK_ENCRYPTION_KEY="your-32-character-or-longer-random-encryption-key"

# Optional fallback encryption key used during key rotation
# BANK_ENCRYPTION_KEY_FALLBACK="your-previous-encryption-key-for-rotation"

# ------------------------------------------------------------------------------
# 5. BACKGROUND CRON & SCHEDULED JOBS
# ------------------------------------------------------------------------------
# Secret token required in Authorization: Bearer <CRON_SECRET> header for:
# - /api/cron/settlement-holds (releases expired return window holds to available balance)
# - /api/cron/membership-expiry (reconciles seller subscription tier expirations)
CRON_SECRET="your-secure-random-cron-secret-token"

# ------------------------------------------------------------------------------
# 6. STOREFRONT BRANDING (OPTIONAL)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME="Vendosmith"
